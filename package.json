{
  "name": "gpt-exporter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension to export ChatGPT conversations (Markdown, HTML, JSON, TXT, PDF) with a pixel-perfect ChatGPT-style UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@types/chrome": "^0.0.287",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
