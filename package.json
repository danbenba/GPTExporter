{
  "name": "gpt-exporter",
  "version": "1.0.0",
  "description": "Chrome extension to export ChatGPT conversations to Markdown, HTML, JSON, TXT or PDF",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "danbenba",
    "url": "https://danbenba.dev"
  },
  "homepage": "https://github.com/danbenba/GPTExporter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbenba/GPTExporter.git"
  },
  "bugs": {
    "url": "https://github.com/danbenba/GPTExporter/issues"
  },
  "keywords": [
    "chatgpt",
    "chrome-extension",
    "manifest-v3",
    "export",
    "markdown",
    "pdf",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@types/chrome": "^0.0.287",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
